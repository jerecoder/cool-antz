{
  "name": "forage_curriculum",
  "backend": "jax",
  "description": "Progressive JAX MAPPO forage curriculum for maps from 4x4 through 15x15.",
  "args": {
    "exp_name": "jax_mappo_forage",
    "total_timesteps": 12800000,
    "num_envs": 16,
    "num_steps": 80,
    "num_minibatches": 4,
    "update_epochs": 4,
    "width": 15,
    "height": 15,
    "obs_width": 15,
    "obs_height": 15,
    "actor_vision_radius": 2,
    "num_ants": 1,
    "food_count": 13,
    "food_sources": 7,
    "cookie_distance": 6,
    "max_steps": 900,
    "pickup_bonus": 0.25,
    "distance_bonus": 0.02,
    "hidden_size": 128,
    "write_bits": 1,
    "seed": 1,
    "quiet": true,
    "random_food": true,
    "random_hub": true
  },
  "metadata": {
    "global_update_cap": 2000,
    "stage_range": "4x4-15x15",
    "notes": "Notebook orchestration may still iterate stage sizes; this config preserves the current cap and default final-stage settings."
  }
}
