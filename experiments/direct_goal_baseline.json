{
  "name": "direct_goal_baseline",
  "backend": "jax",
  "description": "Direct sparse-reward JAX MAPPO baseline for the final 50x50, 3x3-vision, 5-bit, 10-ant AntByte target.",
  "args": {
    "exp_name": "jax_mappo_direct_goal_baseline",
    "total_timesteps": 12800000,
    "num_envs": 16,
    "num_steps": 80,
    "num_minibatches": 4,
    "update_epochs": 4,
    "log_interval": 10,
    "training_rollout_temperature": 0.75,
    "width": 50,
    "height": 50,
    "obs_width": 50,
    "obs_height": 50,
    "actor_vision_radius": 1,
    "num_ants": 10,
    "food_count": 48,
    "food_sources": 25,
    "cookie_distance": 24,
    "max_steps": 10000,
    "pickup_bonus": 0.0,
    "distance_bonus": 0.0,
    "hidden_size": 128,
    "write_bits": 5,
    "write_while_moving": true,
    "seed": 1,
    "quiet": true,
    "random_food": true,
    "random_hub": true
  },
  "metadata": {
    "target": "50x50 map, 3x3 actor vision, 5 writable bits, 10 ants",
    "rollout_policy_temperature": 0.0,
    "wandb_video_max_frames": 1200,
    "reward_shaping": "disabled",
    "food_defaults": {
      "food_count": 48,
      "food_sources": 25,
      "max_steps": 10000
    },
    "notes": "Direct baseline trains the final target from scratch with sparse environment delivery reward only."
  }
}
