{
  "name": "map_ant_gated_mlp_curriculum",
  "backend": "jax",
  "description": "Historical gated JAX MAPPO curriculum that grows both map size and ant count using the original MLP critic.",
  "args": {
    "run_dir": "runs/historical/map_ant_gated_mlp_curriculum",
    "stage_plan": "4:1,6:1,8:2,10:2,12:3,16:4,20:5,25:6,32:8,40:10,50:10",
    "final_food_count": 48,
    "final_food_sources": 2,
    "exp_name": "jax_mappo_map_ant_gated_mlp",
    "seed": 13,
    "num_envs": 8,
    "num_steps": 256,
    "num_minibatches": 4,
    "update_epochs": 4,
    "log_interval": 1,
    "gamma": 0.95,
    "gae_lambda": 0.95,
    "learning_rate": 0.0001,
    "ent_coef": 0.01,
    "training_rollout_temperature": 1.0,
    "vf_coef": 0.5,
    "clip_coef": 0.2,
    "max_grad_norm": 0.5,
    "hidden_size": 128,
    "critic_architecture": "mlp",
    "actor_vision_radius": 1,
    "obs_width": 50,
    "obs_height": 50,
    "write_bits": 1,
    "write_while_moving": true,
    "write_head_transfer": "repeat",
    "pickup_bonus": 0.1,
    "completion_bonus": 0.0,
    "step_penalty": 0.0,
    "write_penalty": 0.0,
    "write_bit_penalty": 0.0,
    "write_bit_penalty_decay": 0.5,
    "write_overwrite_penalty": 0.0,
    "write_entropy_bonus": 0.0,
    "write_entropy_bonus_cap": 0.15,
    "write_bit_entropy_bonus": 0.0,
    "visible_food_approach_bonus": 0.0,
    "visible_food_stall_penalty": 0.0,
    "carrying_hub_approach_bonus": 0.0,
    "carrying_hub_stall_penalty": 0.0,
    "random_food": true,
    "random_hub": true,
    "gate_update_chunk_cap": 500,
    "gate_max_stage_attempts": 6,
    "gate_eval_num_episodes": 16,
    "gate_min_delivered_fraction": 0.95,
    "gate_min_success_rate": 0.75,
    "gate_min_pickup_to_delivery": 0.9,
    "gate_length_fraction": 0.6,
    "gate_eval_modes": "deterministic,sampled",
    "quiet": true
  },
  "metadata": {
    "workflow": "map_ant_gated_curriculum",
    "source_branch": "research/direct-goal-repro-sweep",
    "source_runner": "src/ant_byte_env/training/jax_mappo/map_ant_curriculum.py",
    "historical_result": "Strict gated run passed through 20x20_5_ants, plateaued around 25x25_6_ants, and did not solve 50x50.",
    "failed_new_critic_lineage": "The later autoresearch/map-ant-12x12-conv-critic branch tested a newer critic and failed earlier; this config preserves the old MLP curriculum evidence only.",
    "guardrails": [
      "actor vision radius stays 1",
      "food and hub stay randomized",
      "one writable bit stays enabled",
      "writes are allowed while moving",
      "critic architecture is the original MLP"
    ]
  }
}
