{
  "name": "communication_bits",
  "backend": "jax",
  "description": "15x15 JAX MAPPO communication-bit curriculum using warm-started write heads.",
  "args": {
    "exp_name": "jax_mappo_communication",
    "total_timesteps": 2560000,
    "num_envs": 16,
    "num_steps": 80,
    "num_minibatches": 4,
    "update_epochs": 4,
    "width": 15,
    "height": 15,
    "obs_width": 15,
    "obs_height": 15,
