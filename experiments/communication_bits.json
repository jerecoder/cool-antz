    "num_ants": 1,
    "food_count": 13,
    "food_sources": 7,
    "cookie_distance": 6,
    "max_steps": 900,
    "pickup_bonus": 0.25,
    "distance_bonus": 0.02,
    "hidden_size": 128,
    "write_bits": 2,
    "seed": 1,
    "quiet": true,
    "random_food": true,
    "random_hub": true
  },
  "metadata": {
    "bit_stages": [2, 3, 5, 8],
    "global_update_cap": 2000,
    "base_checkpoint": "runs/legacy/checkpoints/jax_mappo_forage_stage1_15x15.pkl",
    "notes": "Use package warm-start helpers to generate each target write-bit checkpoint before training."
