{
  "name": "communication_bits",
  "backend": "jax",
  "description": "25x25 JAX MAPPO communication-bit curriculum using package-native checkpoints.",
  "args": {
    "exp_name": "jax_mappo_communication",
    "total_timesteps": 2560000,
    "num_envs": 16,
    "num_steps": 80,
    "num_minibatches": 4,
    "update_epochs": 4,
    "width": 25,
    "height": 25,
    "obs_width": 25,
    "obs_height": 25,
    "actor_vision_radius": 1,
    "num_ants": 1,
    "food_count": 23,
    "food_sources": 6,
    "cookie_distance": 11,
    "max_steps": 2500,
    "pickup_bonus": 0.25,
    "distance_bonus": 0.02,
    "write_bit_penalty": 0.0,
    "write_bit_penalty_decay": 0.5,
    "write_entropy_bonus": 0.1,
    "write_entropy_bonus_cap": 0.15,
    "write_head_transfer": "repeat",
    "hidden_size": 128,
    "write_bits": 2,
    "load_model": "runs/notebooks/forage_curriculum/checkpoints/jax_mappo_forage_stage1_25x25.pkl",
    "seed": 1,
    "quiet": true,
    "random_food": true,
    "random_hub": true
  },
  "metadata": {
    "bit_stages": [2, 3, 5, 8],
    "global_update_cap": 2000,
    "source_checkpoint": "runs/notebooks/forage_curriculum/checkpoints/jax_mappo_forage_stage1_25x25.pkl",
    "notes": "Communication training starts from the latest 25x25 one-bit policy produced by the forage curriculum notebook, then transfers through the configured bit stages."
  }
}
