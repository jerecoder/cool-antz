{
  "name": "autocurriculum_50x50_autoresearch",
  "base_config": "experiments/autocurriculum.json",
  "run_root": "runs/autoresearch/autocurriculum",
  "global_update_cap": 1000,
  "probe_rollout_steps": 1000,
  "probe_num_envs": 16,
  "wandb": {
    "project": "cool-antz",
    "group": "autocurriculum_50x50_autoresearch",
    "mode": "online",
    "tags": ["jax", "mappo", "autocurriculum", "single-ant", "50x50", "no-cheat"]
  },
  "rollout": {
    "enabled": true,
    "max_frames": 600,
    "tile_size": 16,
    "policy_temperature": 1.0
  },
  "constraints": {
    "num_ants": 1,
    "actor_vision_radius": 1,
    "write_bits": 1,
    "actor_observation": "local facing-aware patches, carrying flag, and byte bits only",
    "forbidden": [
      "recurrent policy memory",
      "food coordinates in actor observations",
      "hub coordinates in actor observations",
      "food or hub direction vectors",
      "expanded actor vision radius",
      "additional ants"
    ]
  },
  "analysis": {
    "diagnosis": "The existing autocurriculum learns early-stage foraging but stalls as active grids grow; entropy collapses and full episodes usually truncate before 50x50 completion.",
    "reward_plan": "Distance-progress shaping is screened but not assumed to win; also test sparse delivery/pickup reward with lower write noise and lower pickup bonus.",
    "metric_plan": "Rank by fresh vectorized probe active-size progress and deliveries per 1000 environment steps, not raw mixed-run metrics.jsonl curves."
  },
  "phases": {
    "reward": [
      {
        "id": "R0",
        "description": "Current pickup-only baseline for comparison.",
        "run_dir": "runs/autoresearch/autocurriculum/reward/R0",
        "args": {
          "pickup_bonus": 0.25,
          "distance_bonus": 0.0,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 128,
          "num_envs": 16,
          "num_steps": 80,
          "gamma": 0.99,
          "gae_lambda": 0.95
        }
      },
      {
        "id": "R1",
        "description": "Conservative trainer-side progress shaping toward food while empty and hub while carrying.",
        "run_dir": "runs/autoresearch/autocurriculum/reward/R1",
        "args": {
          "pickup_bonus": 0.25,
          "distance_bonus": 0.02,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 128,
          "num_envs": 16,
          "num_steps": 80,
          "gamma": 0.99,
          "gae_lambda": 0.95
        }
      },
      {
        "id": "R2",
        "description": "Recommended first mutation: stronger local progress shaping without changing the true environment reward.",
        "run_dir": "runs/autoresearch/autocurriculum/reward/R2",
        "args": {
          "pickup_bonus": 0.25,
          "distance_bonus": 0.05,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 128,
          "num_envs": 16,
          "num_steps": 80,
          "gamma": 0.99,
          "gae_lambda": 0.95
        }
      },
      {
        "id": "R3",
        "description": "Same progress shaping with lower pickup bonus so navigation is less pickup-dominated.",
        "run_dir": "runs/autoresearch/autocurriculum/reward/R3",
        "args": {
          "pickup_bonus": 0.15,
          "distance_bonus": 0.05,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 128,
          "num_envs": 16,
          "num_steps": 80,
          "gamma": 0.99,
          "gae_lambda": 0.95
        }
      },
      {
        "id": "R4",
        "description": "Current sparse baseline plus a tiny trainer-side write cost to discourage noisy marking.",
        "run_dir": "runs/autoresearch/autocurriculum/reward/R4",
        "args": {
          "pickup_bonus": 0.25,
          "distance_bonus": 0.0,
          "write_bit_penalty": 0.002,
          "write_bit_penalty_decay": 1.0,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 128,
          "num_envs": 16,
          "num_steps": 80,
          "gamma": 0.99,
          "gae_lambda": 0.95
        }
      },
      {
        "id": "R5",
        "description": "Sparse baseline with lower pickup bonus so delivery remains the dominant reward event.",
        "run_dir": "runs/autoresearch/autocurriculum/reward/R5",
        "args": {
          "pickup_bonus": 0.15,
          "distance_bonus": 0.0,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 128,
          "num_envs": 16,
          "num_steps": 80,
          "gamma": 0.99,
          "gae_lambda": 0.95
        }
      },
      {
        "id": "R6",
        "description": "Sparse baseline with writes applied only on stay actions to reduce moving-write memory noise.",
        "run_dir": "runs/autoresearch/autocurriculum/reward/R6",
        "args": {
          "pickup_bonus": 0.25,
          "distance_bonus": 0.0,
          "write_while_moving": false,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 128,
          "num_envs": 16,
          "num_steps": 80,
          "gamma": 0.99,
          "gae_lambda": 0.95
        }
      }
    ],
    "algorithm": [
      {
        "id": "H0",
        "description": "Baseline rollout horizon with the best sparse reward recipe.",
        "run_dir": "runs/autoresearch/autocurriculum/algorithm/H0",
        "args": {
          "pickup_bonus": 0.25,
          "distance_bonus": 0.0,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 128,
          "num_envs": 16,
          "num_steps": 80,
          "gamma": 0.99,
          "gae_lambda": 0.95
        }
      },
      {
        "id": "H1",
        "description": "Longer rollout horizon and longer credit assignment for larger active grids.",
        "run_dir": "runs/autoresearch/autocurriculum/algorithm/H1",
        "global_update_cap": 625,
        "args": {
          "pickup_bonus": 0.25,
          "distance_bonus": 0.0,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 128,
          "num_envs": 8,
          "num_steps": 256,
          "gamma": 0.995,
          "gae_lambda": 0.97
        }
      },
      {
        "id": "H2",
        "description": "Long horizon with lower entropy after the sparse reward baseline starts delivering.",
        "run_dir": "runs/autoresearch/autocurriculum/algorithm/H2",
        "global_update_cap": 625,
        "args": {
          "pickup_bonus": 0.25,
          "distance_bonus": 0.0,
          "step_penalty": 0.0,
          "ent_coef": 0.003,
          "hidden_size": 128,
          "num_envs": 8,
          "num_steps": 256,
          "gamma": 0.995,
          "gae_lambda": 0.97
        }
      },
      {
        "id": "H3",
        "description": "Wider feed-forward policy and critic, still no recurrent memory or actor hints.",
        "run_dir": "runs/autoresearch/autocurriculum/algorithm/H3",
        "global_update_cap": 625,
        "args": {
          "pickup_bonus": 0.25,
          "distance_bonus": 0.0,
          "step_penalty": 0.0,
          "ent_coef": 0.01,
          "hidden_size": 256,
          "num_envs": 8,
          "num_steps": 256,
          "gamma": 0.995,
          "gae_lambda": 0.97
        }
      }
    ],
    "final": [
      {
        "id": "F1",
        "description": "Longer confirmation run for the best sparse reward/horizon recipe.",
        "run_dir": "runs/autoresearch/autocurriculum/final/F1",
        "global_update_cap": 5000,
        "args": {
          "seed": 911,
          "pickup_bonus": 0.25,
          "distance_bonus": 0.0,
          "step_penalty": 0.0,
          "ent_coef": 0.003,
          "hidden_size": 256,
          "num_envs": 8,
          "num_steps": 256,
          "gamma": 0.995,
          "gae_lambda": 0.97
        }
      }
    ]
  }
}
